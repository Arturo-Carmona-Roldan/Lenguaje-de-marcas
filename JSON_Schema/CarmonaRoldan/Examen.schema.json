{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Examen de JSON schemas",
  "description": "Este el el examen de JSON schemas",
  "type":"object",
  "properties": {
    "nombreRestaurante":{
        "type":"string"
    },
    "direccion":{
        "type":"object",
        "properties": {
            "calle":{
                "type":"string"
            },
            "ciudad":{
                "type":"string"
            },
            "codigoPostal":{
                "type":"string",
                "pattern": "^[0-9]{5}$"
            }
        },
        "additionalProperties": false
    },
    "comandas":{
        "type":"array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
            "type":"object",
            "properties": {
                "idComanda":{
                    "type":"string",
                    "pattern": "^[A-C]{2}-[0-9]{3}#$"
                },
                "numeroMesa":{
                    "type":"integer",
                    "minimum": 1,
                    "maximum": 30
                },
                "nombreCamarero":{
                    "type":"string",
                    "maxLength": 20
                },
                "estadoComanda":{
                    "type":"string",
                    "enum": ["pendiente","en preparación", "servida"]
                },
                "platos":{
                    "type":"array",
                    "minimum": 1,
                    "maxItems": 10,
                    "items": {
                        "type":"object",
                        "properties": {
                            "nombrePlato":{
                                "type":"string"
                            },
                            "precio":{
                                "type":"number",
                                "exclusiveMinimum": 0
                            },
                            "cantidad":{
                                "type":"integer",
                                "minimum": 1,
                                "maximum": 10
                            },
                            "extras":{
                                "type":"array",
                                "items": {
                                    "type":"string"
                                }
                            }
                        },
                        "required": ["nombrePlato","precio","cantidad"],
                        "additionalProperties": false
                    }
                },
                "pago":{
                    "type":"object",
                    "properties": {
                        "metodo":{
                            "type":"string",
                            "enum": ["efectivo","tarjeta","online"]
                        },
                        "importeTotal":{
                            "type":"number"
                        }
                    },
                    "required": ["metodo","importeTotal"],
                    "additionalProperties": false
                }
            },
            "required": ["idComanda","numeroMesa","estadoComanda","platos"],
            "additionalProperties": false

        }
    }
  },
  "required": ["nombreRestaurante","direccion"],
  "additionalProperties": false,
  "patternProperties": {
    "^\\$": {}
  }
}