{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title":"Ejercicio 7 JSON",
    "description":"Este es el ejercicio 7 de JSON schemas",
    "type":"object",
    "properties": {
        "patrones":{
            "type":"object",
            "properties": {
                "numeroBinario":{
                    "type":"string",
                    "pattern":"^[01]{1}$"
                },
                "numeroOctal":{
                    "type":"string",
                    "pattern":"^[0-8]{1}$"
                },
                "numeroHexadecimal":{
                    "type":"string",
                    "pattern":"^[0-9A-Z]{1}$"
                },
                "codigoBarras":{
                    "type":"string",
                    "pattern":"^[0-9]{1}(-[0-9]{6}){2}$"
                }
            }
        }
    },
    "additionalProperties": false,
    "patternProperties": {
        "^\\$":{}
    }
}